{
  "name": "rucord",
  "version": "1.0.0",
  "description": "Discord clone - RUCord",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently -k -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npx react-scripts start",
    "electron": "electron ."
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "node-forge": "^1.4.0"
  }
}
